{
    "version": 2,
    "functions": {
        "server/server.js": {
            "memory": 1024,
            "maxDuration": 10
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/server/server.js"
        },
        {
            "source": "/public/(.*)",
            "destination": "/public/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/public/$1"
        }
    ]
}